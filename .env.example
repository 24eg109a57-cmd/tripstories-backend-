# Copy this file to .env (local dev) or set these as environment variables in Render.
# ALL variables below are REQUIRED in production — do not leave any blank.

# CRITICAL: This activates the application-aiven.properties profile (Aiven DB + SSL config).
# Without this, the app falls back to localhost:3306 and crashes.
SPRING_PROFILES_ACTIVE=aiven

PORT=8080

# Aiven MySQL connection details (from your Aiven console > Service > Connection info)
DB_HOST=mysql-37b6a7ca-anurag-0d05.f.aivencloud.com
DB_PORT=14715
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password-here
DB_SSL_MODE=REQUIRED

# Your deployed frontend URL (no trailing slash)
CORS_ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# Generate with: openssl rand -base64 48
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters

# Cloudinary (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
