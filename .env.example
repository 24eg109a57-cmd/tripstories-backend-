# Activate only after the Aiven MySQL service is running and its connection
# details and TLS requirements have been confirmed.
SPRING_PROFILES_ACTIVE=aiven
PORT=8080
DB_HOST=mysql-37b6a7ca-anurag-0d05.f.aivencloud.com
DB_PORT=14715
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=<aiven-password>
DB_SSL_MODE=REQUIRED
CORS_ALLOWED_ORIGIN=https://<your-vercel-domain>
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
